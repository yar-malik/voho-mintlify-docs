{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Voho",
  "description": "Saudi-first AI voice agents for every customer conversation.",
  "colors": {
    "primary": "#016838",
    "light": "#2ec27e",
    "dark": "#016838"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://voho.ai"
  },
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "heading": {
      "family": "Figtree",
      "weight": 600
    },
    "body": {
      "family": "Figtree"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@voho.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Talk to us",
      "href": "mailto:support@voho.ai"
    }
  },
  "footer": {
    "socials": {
      "website": "https://voho.ai"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "icon": "rocket",
        "pages": [
          "index",
          "quickstart",
          "concepts"
        ]
      },
      {
        "group": "Building agents",
        "icon": "wrench",
        "pages": [
          "instructions",
          "actions",
          "voices",
          "handoff"
        ]
      },
      {
        "group": "Running in production",
        "icon": "chart-line",
        "pages": [
          "testing",
          "latency",
          "transcripts",
          "troubleshooting"
        ]
      },
      {
        "group": "Platform",
        "icon": "server",
        "pages": [
          "deployment",
          "security"
        ]
      }
    ]
  },
  "background": {
    "color": {
      "light": "#f4efe5",
      "dark": "#191613"
    }
  }
}
