{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Voho",
  "description": "Saudi-first AI voice agents for every customer conversation.",
  "colors": {
    "primary": "#016838",
    "light": "#2ec27e",
    "dark": "#016838"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://voho.ai"
  },
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "heading": {
      "family": "Figtree",
      "weight": 600
    },
    "body": {
      "family": "Figtree"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@voho.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Talk to us",
      "href": "mailto:support@voho.ai"
    }
  },
  "footer": {
    "socials": {
      "website": "https://voho.ai"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting started",
            "icon": "rocket",
            "pages": [
              "index",
              "quickstart",
              "faq"
            ]
          },
          {
            "group": "Voices and models",
            "icon": "waveform-lines",
            "pages": [
              "voices",
              "models"
            ]
          },
          {
            "group": "Voice agents",
            "icon": "headset",
            "pages": [
              "concepts",
              "instructions",
              "actions",
              "integrations",
              "handoff"
            ]
          },
          {
            "group": "Telephony",
            "icon": "phone",
            "pages": [
              "telephony",
              "numbers"
            ]
          },
          {
            "group": "Running in production",
            "icon": "chart-line",
            "pages": [
              "testing",
              "latency",
              "transcripts",
              "troubleshooting"
            ]
          },
          {
            "group": "Platform",
            "icon": "server",
            "pages": [
              "deployment",
              "security"
            ]
          },
          {
            "group": "On-premise",
            "icon": "building-lock",
            "pages": [
              "on-prem/overview",
              "on-prem/architecture",
              "on-prem/requirements",
              "on-prem/quickstart",
              "on-prem/operations",
              "on-prem/residency"
            ]
          },
          {
            "group": "Partners",
            "icon": "handshake",
            "pages": [
              "partners/overview",
              "partners/white-label"
            ]
          },
          {
            "group": "Commercial",
            "hidden": true,
            "pages": [
              "pricing"
            ],
            "icon": "tag"
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "api-reference/openapi.json",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "api-reference/errors"
            ]
          },
          {
            "group": "Speech",
            "pages": [
              "api-reference/speech",
              "api-reference/speech-stream",
              "api-reference/websocket"
            ]
          },
          {
            "group": "Voices",
            "pages": [
              "api-reference/voices-list",
              "api-reference/voices-get"
            ]
          },
          {
            "group": "Agents",
            "pages": [
              "api-reference/agents-list",
              "api-reference/agents-reply"
            ]
          },
          {
            "group": "Understanding",
            "pages": [
              "api-reference/transcribe",
              "api-reference/documents-extract",
              "api-reference/documents-ask",
              "api-reference/privacy-redact",
              "api-reference/facilities-work-order"
            ]
          },
          {
            "group": "Text utilities",
            "pages": [
              "api-reference/text-normalize",
              "api-reference/text-coverage"
            ]
          }
        ]
      }
    ]
  },
  "background": {
    "color": {
      "light": "#f4efe5",
      "dark": "#191613"
    }
  },
  "redirects": [
    {
      "source": "/pricing-onprem",
      "destination": "/pricing"
    },
    {
      "source": "/pricing-cloud",
      "destination": "/pricing"
    }
  ]
}
